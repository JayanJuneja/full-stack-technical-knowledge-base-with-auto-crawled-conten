{
  "name": "crawlwiki",
  "version": "1.0.0",
  "description": "Mini Confluence-style technical knowledge base: authored wiki pages plus auto-crawled RSS/doc-site content in one search index.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 --test-reporter=./test/reporter.js \"test/*.test.js\"",
    "bench": "node bench/bench.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  }
}
